# AfiliHub — Variáveis de Ambiente
#
# Copie este arquivo para .env e preencha com seus valores.
# Nunca commite o arquivo .env real.
#
# ─── SEPARAÇÃO DE VARIÁVEIS ─────────────────────────────────────────────────────
#
# VITE_*   → Variáveis públicas, incluídas no bundle do frontend.
#            Use APENAS para valores que podem ser expostos ao cliente.
#            NÃO use para API keys, secrets ou tokens de acesso privados.
#
# Sem VITE_ → Variáveis privadas, usadas apenas no servidor (server.ts).
#              Nunca chegam ao browser.
#
# ─────────────────────────────────────────────────────────────────────────────────

# ── Supabase (Público — anon key é segura para o frontend) ───────────────────────
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (Backend — nunca prefixar com VITE_) ────────────────────────────────
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave privada usada apenas pelo backend para sessões e restauração no boot.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini AI (PRIVADO — backend only) ───────────────────────────────────────────
# Obtido em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo usado pelo pipeline de detecção do Monitor.
PROMOTION_AI_MODEL=gemini-3.5-flash-lite
# Modelo usado por CTA, Templates e análise de Product Media.
CTA_MODEL=gemini-3.5-flash-lite
# Fallback global quando um pipeline não tiver modelo específico.
GEMINI_MODEL=gemini-3.5-flash-lite
# Timeout máximo das chamadas do CTA (10–60 segundos; padrão: 40).
CTA_AI_TIMEOUT_MS=40000
# Desative para voltar imediatamente ao fluxo sem banco de candidatos, cache
# persistente e classificação determinística de promoções claras.
AI_COST_OPTIMIZATIONS_ENABLED=true

# ── Aplicação ─────────────────────────────────────────────────────────────────────
# Em produção: https://afilihub.com
APP_URL=http://127.0.0.1:3001
# Em produção use 0.0.0.0. Localmente, 127.0.0.1 reduz a superfície exposta.
HOST=127.0.0.1
# Origens adicionais separadas por vírgula; APP_URL já é permitida automaticamente.
CORS_ALLOWED_ORIGINS=
NODE_ENV=development

# ── Métricas opcionais (públicas; só carregam após consentimento) ─────────────
# Deixe vazio para não carregar trackers nem criar cookies de analytics.
VITE_GOOGLE_ANALYTICS_ID=
VITE_META_PIXEL_ID=

# ── WhatsApp Web / Baileys (PRIVADO — backend only) ───────────────────────────────
# Exatamente 32 bytes em base64 ou 64 caracteres hex.
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_SESSION_ENCRYPTION_KEY=
# Opcional: silent (padrão), error, warn, info, debug
WHATSAPP_LOG_LEVEL=silent

# ── Afiliados (PRIVADO — backend only) ───────────────────────────────────────────
# Exatamente 32 bytes em base64 ou 64 caracteres hex. Protege as credenciais
# individuais dos usuários persistidas em affiliate_accounts.
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AFFILIATE_CREDENTIALS_ENCRYPTION_KEY=
# Provedor principal de navegador remoto. Quando os dois estiverem configurados,
# Hyperbrowser é preferido; use "browserbase" aqui para inverter a prioridade.
MERCADO_LIVRE_REMOTE_BROWSER_PROVIDER=hyperbrowser
HYPERBROWSER_API_KEY=
HYPERBROWSER_USE_PROXY=false
HYPERBROWSER_PROXY_COUNTRY=BR
# Recursos dos planos pagos; mantenha false no plano gratuito.
HYPERBROWSER_USE_STEALTH=false
HYPERBROWSER_SOLVE_CAPTCHAS=false
# Browserbase permanece disponível como contingência e para perfis legados.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_USE_PROXY=false
# Otimizações transparentes da conversão ML. Ações manuais nunca aguardam a
# janela de lote; trabalhos do Monitor/Radar podem ser agrupados por 250 ms.
ML_REMOTE_OPTIMIZATIONS_ENABLED=true
ML_REMOTE_BACKGROUND_BATCH_MS=250
ML_REMOTE_MAX_BATCH_SIZE=20
ML_REMOTE_WARM_SESSION_MS=30000
ML_AFFILIATE_LINK_CACHE_TTL_MS=604800000
# O Radar executa uma única coleta automática diária neste horário local.
MARKETPLACE_RADAR_TIME_ZONE=America/Sao_Paulo
MARKETPLACE_RADAR_DAILY_HOUR=12
MARKETPLACE_RADAR_INTERVAL_SECONDS=86400
MARKETPLACE_RADAR_MANUAL_COOLDOWN_SECONDS=15
# Endpoint oficial da Open API de afiliados Shopee Brasil. Normalmente não precisa alterar.
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# ── Variáveis reservadas para blocos futuros ─────────────────────────────────────
# (Não preencher agora — serão ativadas nos blocos correspondentes)

# Providers futuros — Backend Only
# AMAZON_AFFILIATE_TAG=
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=

# CTA AI Engine (Bloco futuro)
# CTA_MODEL=gemini-2.5-flash
