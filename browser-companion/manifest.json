{
  "manifest_version": 3,
  "name": "AfiliHub Browser Companion",
  "version": "1.1.0",
  "description": "Gera links afiliados do Mercado Livre usando apenas a sessão já autenticada no seu navegador.",
  "key": "",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:3001/api/browser-companion/*",
    "http://localhost:3001/api/browser-companion/*",
    "https://achadosdaamanda.click/api/browser-companion/*",
    "https://mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AfiliHub Companion",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg" }
}
